# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Own database — this is the POPIA boundary. Nothing in here is ever
# forwarded to BFP except via the adapter, and only the fields BFP needs.
DATABASE_URL=postgresql+psycopg://mohlakoana:mohlakoana@localhost:5432/mohlakoana

# Separate secrets per token audience, even though both are HS256 JWTs —
# a leaked staff secret should not compromise client sessions, and vice versa.
STAFF_JWT_SECRET=change-me-staff-secret
CLIENT_JWT_SECRET=change-me-client-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Placeholder until BFP base URL + service-account credentials are confirmed (Phase 3).
BFP_BASE_URL=
BFP_SERVICE_ACCOUNT_EMAIL=
BFP_SERVICE_ACCOUNT_PASSWORD=
